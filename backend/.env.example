# Copy this file to .env and fill in real values

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/shop
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:3000

# Razorpay test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Any email registered from this comma-separated list becomes an admin (auto-verified)
ADMIN_EMAILS=admin@shop.com

# --- email verification (local dev default = MailHog, no config needed) ---
# SMTP_HOST=localhost
# SMTP_PORT=1025
# Real email (Gmail example): host smtp.gmail.com, port 587, USE_TLS=true,
# SMTP_USER=you@gmail.com, SMTP_PASS=<16-char app password>
SMTP_FROM=MyShop <no-reply@myshop.local>
SMTP_USE_TLS=false
# absolute URL of the API, used in verification links sent by email
# PUBLIC_API_URL=http://localhost:8000

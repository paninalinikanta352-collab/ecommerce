# Copy this file to .env and fill in real values

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/shop
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:3000

# Razorpay test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Any email registered from this comma-separated list becomes an admin
ADMIN_EMAILS=admin@shop.com

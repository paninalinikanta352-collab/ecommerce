# Copy this file to .env and fill in real values

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/shop
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:3000

# Razorpay test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Any email registered from this comma-separated list becomes an admin (auto-verified)
ADMIN_EMAILS=admin@shop.com

# --- verification codes ---
# No SMTP configured? Codes show on screen (dev mode). Configure it and they get emailed.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=true,
# SMTP_USER=you@gmail.com, SMTP_PASS=<16-char app password>
SMTP_FROM=MyShop <no-reply@myshop.local>
SMTP_USE_TLS=false
VERIFY_CODE_MINUTES=10
